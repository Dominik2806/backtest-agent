# Normalize line endings: auto-detect text files, store and check out LF everywhere (also on Windows),
# so `ruff format --check` passes on the Windows CI job.
* text=auto eol=lf

# Source, config and docs always use LF, also in the working tree.
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf
*.lock text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.gitkeep       text eol=lf
LICENSE        text eol=lf

# Binary files
*.png    binary
*.jpg    binary
*.gif    binary
