# Normalize line endings: auto-detect text files, store LF in the repo.
* text=auto

# Source, config and docs always use LF, also in the working tree.
# ADAPT: add the extensions of your stack.
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.gitkeep       text eol=lf
LICENSE        text eol=lf

# Binary files
*.png    binary
*.jpg    binary
*.gif    binary
